# ---------------- SALES REPORT ----------------

def daily_sales_report():
    valid, date = check_date()

    if valid == False:
        return

    cur.execute(
        "SELECT SUM(total) FROM sales WHERE sale_date = '" + date + "'"
    )

    result = cur.fetchone()

    if result[0] is None:
        print("No sales on this date.")
    else:
        print("Total Sales on", date, "=", result[0])


def monthly_sales_report():
    month = input("Enter Month (MM) : ")
    year = input("Enter Year (YYYY) : ")

    if len(month) != 2 or len(year) != 4:
        print("Invalid month or year.")
        return

    cur.execute(
        "SELECT SUM(total) FROM sales "
        "WHERE sale_date LIKE '%-" + month + "-" + year + "'"
    )

    result = cur.fetchone()

    if result[0] is None:
        print("No sales in this month.")
    else:
        print("Total Sales =", result[0])


def product_sales_report():
    cur.execute(
        "SELECT p.product_name, SUM(s.quantity), SUM(s.total) "
        "FROM sales s, products p "
        "WHERE s.product_id = p.product_id "
        "GROUP BY p.product_name"
    )

    data = cur.fetchall()

    print("\n-----------------------------------------------")
    print("Product             Quantity        Sales")
    print("-----------------------------------------------")

    for row in data:
        print(row[0], "          ", row[1], "          ", row[2])

    print("-----------------------------------------------")


