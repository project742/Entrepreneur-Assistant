# ---------------- SALES MANAGEMENT ----------------

def add_sale():
    product_id = input("Enter Product ID : ")

    cur.execute(
        "SELECT product_name, price, stock FROM products "
        "WHERE product_id = '" + product_id + "'"
    )

    product = cur.fetchone()

    if product is None:
        print("Product not found.")
        return

    quantity = input("Enter Quantity Sold : ")

    cur.execute(
        "SELECT stock FROM products WHERE product_id = '" + product_id +
        "' AND stock >= " + quantity
    )

    stock_check = cur.fetchone()

    if stock_check is None:
        print("Not enough stock.")
        return

    sale_id = add_uid("S", "sale_id", "sales")
    customer_name = input("Enter Customer Name : ")

    valid, date = check_date()

    if valid == False:
        return

    cur.execute(
        "INSERT INTO sales(sale_id, product_id, customer_name, quantity, sale_date, total) "
        "VALUES('" + sale_id + "', '" + product_id + "', '" +
        customer_name + "', " + quantity + ", '" + date +
        "', (SELECT price FROM products WHERE product_id = '" +
        product_id + "') * " + quantity + ")"
    )

    cur.execute(
        "UPDATE products SET stock = stock - " + quantity +
        " WHERE product_id = '" + product_id + "'"
    )

    x.commit()

    print("Sale added successfully.")
    print("Sale ID :", sale_id)


def update_sale():
    sale_id = input("Enter Sale ID : ")

    cur.execute(
        "SELECT * FROM sales WHERE sale_id = '" + sale_id + "'"
    )

    sale = cur.fetchone()

    if sale is None:
        print("Sale not found.")
        return

    customer_name = input("Enter New Customer Name : ")
    quantity = input("Enter New Quantity : ")

    cur.execute(
        "SELECT stock FROM products "
        "WHERE product_id = '" + sale[1] +
        "' AND stock + (SELECT quantity FROM sales WHERE sale_id = '" +
        sale_id + "') >= " + quantity
    )

    available_stock = cur.fetchone()

    if available_stock is None:
        print("Not enough stock.")
        return

    cur.execute(
        "UPDATE sales SET customer_name = '" + customer_name +
        "', quantity = " + quantity +
        ", total = (SELECT price FROM products WHERE product_id = '" +
        sale[1] + "') * " + quantity +
        " WHERE sale_id = '" + sale_id + "'"
    )

    cur.execute(
        "UPDATE products SET stock = stock + "
        "(SELECT quantity FROM sales WHERE sale_id = '" + sale_id + "') - " +
        quantity + " WHERE product_id = '" + sale[1] + "'"
    )

    x.commit()

    print("Sale updated successfully.")


def delete_sale():
    sale_id = input("Enter Sale ID : ")

    cur.execute(
        "SELECT * FROM sales WHERE sale_id = '" + sale_id + "'"
    )

    sale = cur.fetchone()

    if sale is None:
        print("Sale not found.")
        return

    cur.execute(
        "UPDATE products SET stock = stock + "
        "(SELECT quantity FROM sales WHERE sale_id = '" + sale_id + "') "
        "WHERE product_id = '" + sale[1] + "'"
    )

    cur.execute(
        "DELETE FROM sales WHERE sale_id = '" + sale_id + "'"
